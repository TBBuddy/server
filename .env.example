NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3001
DEFAULT_TIMEZONE=Asia/Jakarta

MONGODB_CONNECTION=mongodb+srv://<username>:<password>@<cluster>/?appName=TBuddy
MONGODB_DATABASE=tbuddy

REDIS_ENABLED=true
REDIS_URL=redis://<username>:<password>@<host>:<port>
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PREFIX=tbbudy

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=3600
BCRYPT_ROUNDS=12

ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=TBuddy Administrator

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_MS=

MAIL_ENABLED=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=TBuddy

EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
